# Основной сайт
PORT=3000
SITE_URL=https://sibir-optika.ru

# Роли CRM. В реальном .env задайте сильные пароли.
ADMIN_PASSWORD=replace-with-strong-admin-password
STAFF_PASSWORD=replace-with-strong-staff-password
SESSION_SECRET=replace-with-long-random-secret

# PostgreSQL. MCP тоже использует DATABASE_URL и читает реальные данные CRM из этой базы.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sibir_optika
DATABASE_SSL=false

# MCP: по умолчанию персональные данные заявок маскируются.
# Ставить true только локально и только если точно нужно видеть имена/телефоны в AI-клиенте.
MCP_EXPOSE_PERSONAL_DATA=false
